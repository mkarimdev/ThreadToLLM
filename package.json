{
  "name": "thread-to-llm",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension to extract Reddit discussion threads and format them into token-dense Markdown for LLMs",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.core.json --noEmit",
    "typecheck:core": "tsc --project tsconfig.core.json --noEmit",
    "test": "vitest run",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.0",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.5"
  }
}
