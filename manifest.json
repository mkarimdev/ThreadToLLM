{
  "manifest_version": 3,
  "name": "ThreadToLLM",
  "version": "0.1.0",
  "description": "Extract Reddit discussion threads and format them into token-dense Markdown for LLMs",
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.reddit.com/*"
  ],
  "background": {
    "service_worker": "src/extension/background.ts",
    "type": "module"
  },
  "commands": {
    "copy-thread": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Copy Reddit thread for LLM"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.reddit.com/*"
      ],
      "js": [
        "src/extension/content.ts"
      ],
      "run_at": "document_idle"
    }
  ]
}
